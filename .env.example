# Copy to .env for local runs (never commit .env). On Cloud Run use Secret Manager instead.

# --- Gemini (server-side only; never sent to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Google Maps ---
# Browser key: sent to the browser by design. Restrict it in Cloud Console to
#   HTTP referrers (your domain) + Maps JavaScript API + Map Tiles API.
GOOGLE_MAPS_BROWSER_KEY=
# Server key: Routes API only, never sent to the browser. Restrict by API.
GOOGLE_MAPS_SERVER_KEY=
# Legacy single-key fallback used if the two above are unset (not recommended).
GOOGLE_MAPS_API_KEY=

# --- Sessions / identity ---
# Random 64+ hex chars. If unset, a per-process secret is generated (sessions reset on restart).
TATHYON_SESSION_SECRET=
# 1 = allow signed demo identities (no identity provider is connected). Set 0 to disable.
TATHYON_DEMO_LOGIN=1

# --- Storage ---
# 1 = SQLite ledger (replayed on start). On Cloud Run the filesystem is ephemeral.
TATHYON_DB=0
TATHYON_DATA_DIR=./data
# Optional comma-separated origins for cross-origin API use. Default: same-origin only.
TATHYON_CORS_ORIGINS=

# Comma-separated OSM district keys to load at boot when the workspace is empty (real public data only).
TATHYON_AUTOLOAD_OSM=
